# Copy to .env for local development. On Render, set these as environment
# variables in the service's Environment tab instead of committing a .env file.

# Neon Postgres connection string (from your Neon project's dashboard).
# Use the "pooled connection" string if Neon offers one.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Any long random string — used to sign login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Account 1 (you) and Account 2 (your girlfriend). These are only used to
# SEED the `accounts` table the very first time the app starts up and finds
# it empty — after that, passwords live in the database and are changed via
# the app's own "Change password" / "Forgot password" flows, not by editing
# these env vars. Generate a hash with: npm run hash-password -- "your password"
AUTH_USER_1_EMAIL=you@example.com
AUTH_USER_1_PASSWORD_HASH=

AUTH_USER_2_EMAIL=partner@example.com
AUTH_USER_2_PASSWORD_HASH=

# Resend (https://resend.com) API key, used to send "forgot password" reset
# links. Without this set, the app still runs fine and reset links can still
# be requested — the email just won't actually be sent (a warning is logged
# instead). RESEND_FROM_EMAIL must be an address/domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Wedding Ledger <noreply@yourdomain.com>

NODE_ENV=production
